# Course key. SpendSmart calls gpt-6-luna with this key and no other model.
# Leave it blank only if you are paying with your own OpenAI key.
PORTKEY_API_KEY=

# Your own OpenAI key. Used only when PORTKEY_API_KEY is empty.
OPENAI_API_KEY=

# Model name for OPENAI_API_KEY. Ignored when the course key is set.
OPENAI_MODEL=
